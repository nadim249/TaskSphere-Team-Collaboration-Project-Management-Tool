@model TaskSphere.Models.DashboardVM

<div class="container-fluid py-4">
    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1"> Dashboard</h2>
        <p class="text-muted">Complete overview of all projects, tasks, and team performance</p>
    </div>

    <div class="row gx-4 mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm p-4 h-100" style="background-color: #f0f5ff; border-radius: 16px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="bg-primary text-white p-3 rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-folder-fill fs-5"></i>
                    </div>
                    <span class="text-success small fw-bold"><i class="bi bi-arrow-up-right me-1"></i>@Model.ProjectGrowthString</span>
                </div>
                <h2 class="fw-bold mb-1">@Model.TotalProjects</h2>
                <span class="text-muted small fw-medium">Total Projects</span>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm p-4 h-100" style="background-color: #fbf2ff; border-radius: 16px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="text-white p-3 rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: #a855f7;">
                        <i class="bi bi-people-fill fs-5"></i>
                    </div>
                    <span class="text-purple small fw-bold" style="color: #a855f7;"><i class="bi bi-arrow-up-right me-1"></i>@Model.MemberGrowthString</span>
                </div>
                <h2 class="fw-bold mb-1">@Model.TotalTeamMembers</h2>
                <span class="text-muted small fw-medium">Team Members</span>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm p-4 h-100" style="background-color: #f0fdf4; border-radius: 16px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="bg-success text-white p-3 rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                    </div>
                    <span class="text-success small fw-bold"><i class="bi bi-arrow-up-right me-1"></i>@Model.TaskCompletionRateString</span>
                </div>
                <h2 class="fw-bold mb-1">@Model.CompletedTasksCount</h2>
                <span class="text-muted small fw-medium">Completed Tasks</span>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm p-4 h-100" style="background-color: #fef2f2; border-radius: 16px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="bg-danger text-white p-3 rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-exclamation-circle-fill fs-5"></i>
                    </div>
                    <span class="text-danger small fw-bold bg-white px-2 py-1 rounded border border-danger-subtle">
                        <i class="bi bi-graph-up me-1"></i>@Model.UrgentLabelString
                    </span>
                </div>
                <h2 class="fw-bold mb-1">@Model.PendingTasksCount</h2>
                <span class="text-muted small fw-medium">Pending Tasks</span>
            </div>
        </div>
    </div>

    <div class="row gx-4">

        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 16px; min-height: 400px;">
                <h5 class="fw-bold text-dark mb-4">Critical Deadlines</h5>

                <div class="d-flex flex-column gap-3">
                    @if (!Model.CriticalProjects.Any())
                    {
                        <div class="text-center py-5 text-muted small">
                            <i class="bi bi-calendar-check fs-2 mb-2 d-block"></i>
                            No critical upcoming deadlines found!
                        </div>
                    }
                    @foreach (var proj in Model.CriticalProjects)
                    {
                        <div class="p-3 rounded-3 d-flex justify-content-between align-items-center" style="background-color: rgba(0,0,0,0.015); border: 1px solid rgba(0,0,0,0.03);">
                            <div>
                                <h6 class="fw-bold text-dark mb-1">@proj.Title</h6>
                                <span class="small text-muted">@proj.TasksRemainingCount tasks remaining</span>
                            </div>
                            <div class="text-end">
                                <span class="fw-bold d-block small @(proj.DaysLeft <= 3 ? "text-danger" : "text-warning")" style="color: #d97706;">
                                    @proj.DaysLeft days left
                                </span>
                                <small class="text-muted text-opacity-70" style="font-size: .75em">@proj.TargetDeadline.ToString("M/dd/yyyy")</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 16px; min-height: 400px;">
                <h5 class="fw-bold text-dark mb-4">Top Performers</h5>

                <div class="d-flex flex-column gap-3">
                    @{
                        int rankingIndex = 1;
                    }
                    @if (!Model.TopPerformers.Any())
                    {
                        <div class="text-center py-5 text-muted small">
                            <i class="bi bi-person-x fs-2 mb-2 d-block"></i>
                            No task tracking metrics found.
                        </div>
                    }
                    @foreach (var user in Model.TopPerformers)
                    {
                        string bgIndexColor = rankingIndex == 1 ? "#eab308" : rankingIndex == 2 ? "#94a3b8" : rankingIndex == 3 ? "#f97316" : "#3b82f6";

                        <div class="d-flex align-items-center justify-content-between p-2 rounded-3 hover-stripe">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle text-white fw-bold d-flex align-items-center justify-content-center"
                                     style="width: 36px; height: 36px; background-color: @bgIndexColor; font-size: 0.9rem;">
                                    @rankingIndex
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-0">@user.FullName</h6>
                                    <small class="text-muted" style="font-size: 0.8rem;">@user.Role</small>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="fw-bold text-success fs-5 d-inline-block me-1">@user.TasksCompletedCount</span>
                                <small class="text-muted d-block" style="font-size: 0.75rem;">completed</small>
                            </div>
                        </div>

                        rankingIndex++;
                    }
                </div>
            </div>
        </div>

    </div>
</div>