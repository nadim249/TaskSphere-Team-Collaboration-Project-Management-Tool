@model List<TaskSphere.Entities.Project>

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm project-card" style="border-radius: 15px;">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="fw-bold m-0 text-dark">@item.Title</h5>
                        <div class="d-flex gap-2">
                            <a href="javascript:void(0)" onclick="openProjectEdit(@item.ProjectId)" class="text-secondary">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <button type="button" onclick="confirmDelete(@item.ProjectId)" class="border-0 bg-transparent p-0 text-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>

                    <p class="text-muted small text-truncate mb-3" style="max-width: 100%;">
                        @(string.IsNullOrEmpty(item.Description) ? "No description provided." : item.Description)
                    </p>

                    <div class="mb-3">
                        @{
                            var isHigh = item.Priority == "High" || item.Priority == "Critical";
                            var badgeStyle = isHigh ? "background-color: #fee2e2; color: #991b1b;" : "background-color: #fef9c3; color: #854d0e;";
                        }
                        <span class="badge rounded-pill px-3 py-2" style="@badgeStyle font-weight: 600;">@item.Priority Priority</span>
                    </div>
                    <div class="mt-3 pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="small fw-semibold text-dark">Tasks</div>
                            <span class="badge rounded-pill bg-light text-dark border">@(item.Tasks?.Count ?? 0)</span>
                        </div>

                        @if (item.Tasks != null && item.Tasks.Any())
                        {
                            <div class="d-grid gap-2 mb-3" style="max-height: 14rem; overflow-y: auto;">
                                @foreach (var task in item.Tasks.Take(3))
                                {
                                    <div class="p-2 rounded-3 border bg-light">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div>
                                                <div class="fw-semibold text-dark" style="font-size: 0.85rem;">@task.Title</div>
                                                <div class="text-muted small">@task.Assignee?.FullName</div>
                                            </div>
                                            <span class="badge rounded-pill @(task.Status == "Completed" ? "bg-success" : task.Status == "In Progress" ? "bg-primary" : "bg-secondary")">@task.Status</span>
                                        </div>
                                        <div class="text-muted small mt-1">Due: @task.DueDate.ToString("M/d/yyyy")</div>
                                    </div>
                                }
                                @if (item.Tasks.Count > 3)
                                {
                                    <div class="text-muted small text-center">and @(item.Tasks.Count - 3) more task(s)</div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small mb-3">No tasks assigned to this project yet.</div>
                        }

                        <div class="text-muted small mt-auto">
                            <div class="mb-1"><i class="bi bi-calendar3 me-2"></i> Due: @(item.Deadline?.ToString("M/d/yyyy") ?? "TBD")</div>
                            <div><i class="bi bi-person me-2"></i> Created By: @item.CreatedBy</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>