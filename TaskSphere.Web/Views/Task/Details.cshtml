@model PTask
@Html.Partial("_Message")

<div class="container py-5 d-flex justify-content-center">
    <div class="card shadow-lg border-0 rounded-4" style="max-width: 800px; width: 100%;">
        <!-- Top Toolbar -->
        <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center p-4">
            <h5 class="fw-bold text-dark mb-0">Task Details</h5>
            <div class="d-flex gap-3">
                <a asp-action="Edit" asp-controller="Task" asp-route-id="@Model.TaskId" class="text-primary fs-5"><i class="bi bi-pencil-square"></i></a>
                <a asp-action="Index" asp-controller="Task" class="btn-close"></a>
            </div>
        </div>

        <div class="card-body px-4 pt-0">
            <h2 class="fw-bold mb-3">@Model.Title</h2>

            <div class="mb-4 d-flex gap-2">
                <span class="badge bg-danger-subtle text-danger px-3 py-2 text-uppercase">@Model.Status</span>
                <span class="badge bg-warning-subtle text-warning px-3 py-2">
                    <i class="bi bi-flag-fill me-1"></i> @Model.Priority.ToUpper() PRIORITY
                </span>
            </div>

            <!-- Meta Info Box @Model.Assignee.FullName   -->
            <div class="bg-light rounded-4 p-4 mb-4">
                <div class="mb-2"><i class="bi bi-folder2 me-2"></i> <strong>Project:</strong>@Model.Project.Title</div>
                <div class="mb-2"><i class="bi bi-person me-2"></i> <strong>Assigned to:</strong> @Model.Assignee.FullName</div>
                <div><i class="bi bi-calendar3 me-2"></i> <strong>Due date:</strong> @Model.DueDate.ToString("ddd, MMM dd, yyyy")</div>
            </div>

            <h6 class="fw-bold text-muted mb-2 text-uppercase small">Description</h6>
            <p class="mb-4">@Model.Description</p>

            <hr class="text-muted opacity-25" />

          
            <!-- Attachments Section -->
        <h6 class="fw-bold mb-3"><i class="bi bi-paperclip"></i> Attachments</h6>

        @foreach (var attachment in Model.Attachments)
        {
    
                var filePath = attachment.FilePath ?? "";
                var fileExtension = filePath.Contains('.') ? filePath.Substring(filePath.LastIndexOf('.')).ToLower() : "";
                var isImage = new[] { ".png", ".jpg", ".jpeg" }.Contains(fileExtension);
    

            <div class="d-flex align-items-center gap-3 mb-3">
                @if (isImage)
                {
                    <a href="@attachment.FilePath" target="_blank" class="text-decoration-none">
                        <img src="@attachment.FilePath" alt="@attachment.Filename" 
                             style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;" />
                    </a>
                }
                else
                {
                    <a href="@attachment.FilePath" download class="text-decoration-none">
                        <i class="bi bi-file-earmark-pdf fs-4 text-danger"></i>
                    </a>
                }

                <div>
                    <a href="@attachment.FilePath" download class="text-decoration-none text-dark fw-bold">
                        @attachment.Filename
                    </a>
                    <small class="text-muted d-block">Uploaded on @attachment.UploadedAt?.ToString("MMM dd, yyyy")</small>
                </div>
            </div>
        }

            <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data">
                <input type="hidden" name="taskId" value="@Model.TaskId" />
                <div class="border border-2 border-dashed rounded-3 p-2 text-center mb-2 text-muted" style="border-style: dashed !important;">
                    <i class="bi bi-cloud-arrow-up fs-1"></i>
                    <p class="mb-0 mt-1">
                        <label for="fileInput" style="cursor:pointer;">
                            <span class="text-primary fw-bold">Click to upload</span>
                        </label>
                    </p>
                    <small>PDF, DOC, PNG, JPG (max 50MB)</small>
                    <input type="file" id="fileInput" name="file" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg" style="display:none;" onchange="this.form.submit();" />
                </div>
            </form>

            <!-- Comments Section -->
            @foreach (var comment in Model.Comments)
            {
                <div class="d-flex gap-3 mb-3">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                         style="width: 40px; height: 40px;">
                        @comment.User?.FullName.Substring(0, 1).ToUpper()
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="fw-bold mb-1">@comment.User?.FullName</h6>
                        <p class="mb-0">@comment.Message</p>
                        <a onclick="return confirm('Are you sure?');" asp-controller="Task" asp-action="DeleteComment" asp-route-id="@comment.CommentId" class="text-danger"><i class="bi bi-trash"></i></a>

                        <small class="text-muted">@comment.CreatedAt?.ToString("MMM dd, yyyy")</small>
                    </div>
                </div>
            }   
            <div class="d-flex gap-3 mb-4">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                     style="width: 40px; height: 40px;">
                    U
                </div>
                <div class="flex-grow-1 position-relative">
                    <form asp-action="AddComment" asp-controller="Task" method="post">
                        <input type="hidden" name="taskId" value="@Model.TaskId" />
                        <textarea class="form-control rounded-4 shadow-sm" name="message" placeholder="Add a comment..." rows="3" required></textarea>
                        <div class="d-flex justify-content-end align-items-center mt-2 px-1">
                            <button type="submit" class="btn btn-outline-primary">
                                <i class="bi bi-send me-1"></i> Comments
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-danger-subtle {
        background-color: #ffe5e5 !important;
    }

    .bg-warning-subtle {
        background-color: #fff9db !important;
    }

    .border-dashed {
        border-color: #dee2e6 !important;
    }
</style>