@model TaskSphere.Models.SignUpModel

<style>
    /* Custom tweaks to match the image precisely */
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
    }

    body {
        background-color: #eef2f7; /* Soft blue-gray background */
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .login-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        max-width: 380px;
        margin: 0 auto;
        width: 100%;
        padding: 2rem !important;
    }

    .brand-icon-wrapper {
        width: 50px;
        height: 50px;
        background-color: #584af7;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        margin: 0 auto 12px auto;
        font-size: 1.5rem;
    }

    .btn-custom-purple {
        background-color: #584af7;
        border-color: #584af7;
        color: white;
        border-radius: 8px;
        padding: 8px;
        font-weight: 600;
        font-size: 0.9rem;
    }

        .btn-custom-purple:hover {
            background-color: #4335d7;
            border-color: #4335d7;
            color: white;
        }

    .form-control {
        border-radius: 8px;
        padding: 8px 12px;
        border: 1px solid #dee2e6;
        font-size: 0.9rem;
    }

        .form-control:focus {
            border-color: #584af7;
            box-shadow: 0 0 0 0.25rem rgba(88, 74, 247, 0.25);
        }

    .password-wrapper {
        position: relative;
    }

    .password-toggle-icon {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
        cursor: pointer;
        font-size: 1rem;
    }

    .password-requirements-box {
        background-color: #f0f4f9;
        border-radius: 8px;
        padding: 12px;
        font-size: 0.8rem;
    }

    .text-purple {
        color: #584af7 !important;
    }

        .text-purple:hover {
            color: #4335d7 !important;
            text-decoration: underline;
        }

    h2 {
        font-size: 1.3rem;
    }

    .form-label {
        font-size: 0.8rem !important;
    }
</style>

<div class="container d-flex flex-column justify-content-center align-items-center mt-5 my-5">
    <div style="max-width: 380px; width: 100%;">
        @Html.Partial("_Message")
    </div>
    <div class="card login-card p-3 p-sm-5 bg-white">

        <div class="brand-icon-wrapper">
            <i class="bi bi-person-plus-fill"></i>
        </div>

        <div class="text-center mb-2">
            <h2 class="fw-bold text-dark m-0">Create Account</h2>
            <p class="text-muted small mt-1">Join TaskSphere and start collaborating</p>
        </div>

        <form method="post" asp-action="SignUp" asp-controller="Auth">
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-semibold text-secondary small">Full Name</label>
                <input asp-for="FullName" type="text" class="form-control" placeholder="John Doe" required/>
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold text-secondary small">Email Address</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="you@example.com" required/>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold text-secondary small">Password</label>
                <div class="password-wrapper">
                    <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required/>
                    <i class="bi bi-eye password-toggle-icon" onclick="togglePasswordVisibility('Password', this)"></i>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold text-secondary small">Confirm Password</label>
                <div class="password-wrapper">
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" required/>
                    <i class="bi bi-eye password-toggle-icon" onclick="togglePasswordVisibility('ConfirmPassword', this)"></i>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="password-requirements-box mb-4 text-secondary">
                <div class="fw-bold mb-1 text-purple">Password Requirements</div>
                <ul class="list-unstyled m-0 lh-base">
                    <li>
                        <i class="bi bi-dot text-purple"></i> <span class="text-muted">At least 6 characters long</span>
                    </li>
                    <li>
                        <i class="bi bi-dot text-purple"></i> <span class="text-muted">Passwords must match</span>
                    </li>
                </ul>
            </div>

            <button type="submit" class="btn btn-custom-purple w-100 mb-4">Create Account</button>
        </form>

        <div class="text-center small text-secondary">
            Already have an account? <a asp-action="SignIn" asp-controller="Auth" class="text-purple fw-semibold text-decoration-none">Sign in</a>
        </div>

    </div>
</div>

@section Scripts
{
    @Html.Partial("_ValidationScriptsPartial")

    <script>
        function togglePasswordVisibility(inputId, iconElement) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                iconElement.classList.replace("bi-eye", "bi-eye-slash");
            } else {
                input.type = "password";
                iconElement.classList.replace("bi-eye-slash", "bi-eye");
            }
        }
    </script>
}