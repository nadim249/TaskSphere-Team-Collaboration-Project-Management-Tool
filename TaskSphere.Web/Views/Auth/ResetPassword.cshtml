@model TaskSphere.Models.ResetPasswordModel

<style>
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
    }

    body {
        background-color: #eef2f7;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .login-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        max-width: 380px;
        margin: 0 auto;
        width: 100%;
        padding: 2rem !important;
    }

    .brand-icon-wrapper {
        width: 50px;
        height: 50px;
        background-color: #584af7;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        margin: 0 auto 12px auto;
        font-size: 1.5rem;
    }

    .btn-custom-purple {
        background-color: #584af7;
        border-color: #584af7;
        color: white;
        border-radius: 8px;
        padding: 8px;
        font-weight: 600;
        font-size: 0.9rem;
    }

        .btn-custom-purple:hover {
            background-color: #4335d7;
            border-color: #4335d7;
            color: white;
        }

    .form-control {
        border-radius: 8px;
        padding: 8px 12px;
        border: 1px solid #dee2e6;
        font-size: 0.9rem;
    }

        .form-control:focus {
            border-color: #584af7 !important;
            box-shadow: 0 0 0 0.25rem rgba(88, 74, 247, 0.25);
        }

    .password-wrapper {
        position: relative;
    }

    .password-toggle-icon {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
        cursor: pointer;
    }
</style>

<div class="container d-flex flex-column justify-content-center align-items-center mt-5">
    <div style="max-width: 380px; width: 100%;">
        @Html.Partial("_Message")
    </div>

    <div class="card login-card p-3 p-sm-5 bg-white">
        <div class="brand-icon-wrapper">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <div class="text-center mb-3">
            <h2 class="fw-bold text-dark m-0 fs-5">Reset Password</h2>
            <p class="text-muted small mt-2">Create a secure new password for your account.</p>
        </div>

        <form method="post" asp-action="ResetPassword" asp-controller="Auth">
            <input type="hidden" asp-for="Email" />

            <div class="mb-3 text-start">
                <label asp-for="NewPassword" class="form-label fw-semibold text-secondary small mb-1">New Password</label>
                <div class="password-wrapper">
                    <input asp-for="NewPassword" type="password" id="NewPassword" class="form-control" placeholder="••••••••" required />
                    <i class="bi bi-eye password-toggle-icon" onclick="toggleVisibility('NewPassword', this)"></i>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4 text-start">
                <label asp-for="ConfirmNewPassword" class="form-label fw-semibold text-secondary small mb-1">Confirm New Password</label>
                <div class="password-wrapper">
                    <input asp-for="ConfirmNewPassword" type="password" id="ConfirmNewPassword" class="form-control" placeholder="••••••••" required />
                    <i class="bi bi-eye password-toggle-icon" onclick="toggleVisibility('ConfirmNewPassword', this)"></i>
                </div>
                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-custom-purple w-100">Reset Password</button>
        </form>
    </div>
</div>

@section Scripts {
    @Html.Partial("_ValidationScriptsPartial")
    <script>
        function toggleVisibility(inputId, icon) {
            const el = document.getElementById(inputId);
            if (el.type === "password") {
                el.type = "text";
                icon.classList.replace("bi-eye", "bi-eye-slash");
            } else {
                el.type = "password";
                icon.classList.replace("bi-eye-slash", "bi-eye");
            }
        }
    </script>
}