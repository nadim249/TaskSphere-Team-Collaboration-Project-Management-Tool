@using System.Security.Claims
@model PTask
@Html.Partial("_Message")

<div class="container py-5 d-flex justify-content-center">
    <div class="card shadow-lg border-0 rounded-4" style="max-width: 800px; width: 100%;">
        <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center p-4">
            <h5 class="fw-bold text-dark mb-0">Task Details</h5>
            <div class="d-flex gap-3">
                <a asp-action="Index" asp-controller="TMemberTask" class="btn-close"></a>
            </div>
        </div>

        <div class="card-body px-4 pt-0">
            <h2 class="fw-bold mb-3">@Model.Title</h2>

            <div class="mb-4 d-flex gap-2">
                <span class="badge bg-danger-subtle text-danger px-3 py-2 text-uppercase">@Model.Status</span>
                <span class="badge bg-warning-subtle text-warning px-3 py-2">
                    <i class="bi bi-flag-fill me-1"></i> @Model.Priority?.ToUpper() PRIORITY
                </span>
            </div>

            <div class="bg-light rounded-4 p-4 mb-4">
                <div class="mb-2"><i class="bi bi-folder2 me-2"></i> <strong>Project:</strong> @Model.Project?.Title</div>
                <div class="mb-2"><i class="bi bi-person me-2"></i> <strong>Assigned to:</strong> @Model.Assignee?.FullName</div>
                <div><i class="bi bi-calendar3 me-2"></i> <strong>Due date:</strong> @Model.DueDate.ToString("ddd, MMM dd, yyyy")</div>
            </div>

            <h6 class="fw-bold text-muted mb-2 text-uppercase small">Description</h6>
            <p class="mb-4">@Model.Description</p>

            <hr class="text-muted opacity-25" />

            <h6 class="fw-bold mb-3"><i class="bi bi-paperclip"></i> Attachments (@Model.Attachments?.Count)</h6>

            @if (Model.Attachments != null && Model.Attachments.Any())
            {
                @foreach (var attachment in Model.Attachments)
                {
                    var filePath = attachment.FilePath ?? "";
                    var fileExtension = filePath.Contains('.') ? filePath.Substring(filePath.LastIndexOf('.')).ToLower() : "";
                    var isImage = new[] { ".png", ".jpg", ".jpeg" }.Contains(fileExtension);

                    <div class="d-flex align-items-center gap-3 mb-3 p-2 border rounded-3 bg-white shadow-sm">
                        @if (isImage)
                        {
                            <a href="@attachment.FilePath" target="_blank" class="text-decoration-none">
                                <img src="@attachment.FilePath" alt="@attachment.Filename"
                                     style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;" />
                            </a>
                        }
                        else
                        {
                            <a href="@attachment.FilePath" download class="text-decoration-none">
                                <i class="bi bi-file-earmark-pdf fs-2 text-danger"></i>
                            </a>
                        }

                        <div>
                            <a href="@attachment.FilePath" download class="text-decoration-none text-dark fw-bold d-block">
                                @attachment.Filename
                            </a>
                            <small class="text-muted d-block">Uploaded on @attachment.UploadedAt?.ToString("MMM dd, yyyy")</small>
                        </div>
                    </div>
                }
            }

            <form asp-action="UploadAttachment" asp-controller="TMemberTask" method="post" enctype="multipart/form-data">
                <input type="hidden" name="taskId" value="@Model.TaskId" />
                <div class="border border-2 border-dashed rounded-3 p-3 text-center mb-4 text-muted" style="border-style: dashed !important; background-color: #fafafa;">
                    <i class="bi bi-cloud-arrow-up fs-1 text-primary"></i>
                    <p class="mb-0 mt-1">
                        <label for="fileInput" style="cursor:pointer;">
                            <span class="text-primary fw-bold">Click to upload</span> template files
                        </label>
                    </p>
                    <small>PDF, DOC, PNG, JPG (max 50MB)</small>
                    <input type="file" id="fileInput" name="file" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg" style="display:none;" onchange="this.form.submit();" />
                </div>
            </form>

            <hr class="text-muted opacity-25" />

            <h6 class="fw-bold mb-4"><i class="bi bi-chat-left-text text-muted me-2"></i>Discussion Area</h6>

            @if (Model.Comments != null)
            {
                @foreach (var comment in Model.Comments)
                {
                    <div class="d-flex gap-3 mb-4 p-2 rounded-3 border-bottom">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
                             style="width: 40px; height: 40px; min-width: 40px;">
                            @(string.IsNullOrEmpty(comment.User?.FullName) ? "U" : comment.User.FullName.Substring(0, 1).ToUpper())
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <h6 class="fw-bold mb-0 text-dark small">@comment.User?.FullName</h6>
                                <div class="d-flex align-items-center gap-2">
                                    <small class="text-muted extra-small">@comment.CreatedAt?.ToString("MMM dd, yyyy hh:mm tt")</small>
                                    @if (User.FindFirst("UserId")?.Value == comment.UserId.ToString())
                                    {
                                        <a onclick="return confirm('Are you sure you want to delete this comment?');"
                                           asp-controller="TMemberTask" asp-action="DeleteComment" asp-route-id="@comment.CommentId"
                                           class="text-danger small"><i class="bi bi-trash"></i></a>
                                    }
                                </div>
                            </div>
                            <p class="mb-1 text-secondary small">@comment.Message</p>
                        </div>
                    </div>
                }
            }

            <div class="d-flex gap-3 mt-4">
                <div class="rounded-circle bg-purple-subtle text-primary d-flex align-items-center justify-content-center fw-bold border border-primary-subtle"
                     style="width: 40px; height: 40px; min-width: 40px; background-color: #eef2ff;">
                    <i class="bi bi-pencil"></i>
                </div>
                <div class="flex-grow-1">
                    <form asp-action="AddComment" asp-controller="TMemberTask" method="post">
                        <input type="hidden" name="taskId" value="@Model.TaskId" />
                        <textarea class="form-control rounded-3 shadow-sm border" name="message" placeholder="Add a comment..." rows="3" required></textarea>
                        <div class="d-flex justify-content-end mt-2">
                            <button type="submit" class="btn btn-primary px-4 rounded-3 shadow-sm btn-sm">
                                <i class="bi bi-send me-1"></i> Post Comment
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .bg-danger-subtle {
        background-color: #ffe5e5 !important;
    }

    .bg-warning-subtle {
        background-color: #fff9db !important;
    }

    .border-dashed {
        border-color: #dee2e6 !important;
    }

    .extra-small {
        font-size: 0.75rem;
    }
</style>