@model List<PTask>
@{
    ViewData["Title"] = "Task Board";
    var statuses = new[] { "Pending", "In Progress", "Completed" };
}
@Html.Partial("_Message")

<div class="container-fluid py-4 bg-light min-vh-100">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">My Tasks</h2>
            <p class="text-muted">Manage your daily tasks and update their progress</p>
        </div>
    </div>

    <form asp-action="Index" method="get">
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="input-group bg-white rounded-3 shadow-sm border overflow-hidden">
                    <span class="input-group-text bg-white border-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="searchTerm" class="form-control border-0 px-1" placeholder="Search tasks...">
                </div>
            </div>
            <div class="col-md-3">
                <select name="priority" class="form-select border-0 shadow-sm rounded-3">
                    <option value="">All Priorities</option>
                    <option value="Critical">Critical</option>
                    <option value="High">High</option>
                    <option value="Medium">Medium</option>
                    <option value="Low">Low</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-outline-secondary w-100 rounded-3 shadow-sm">
                    <i class="bi bi-funnel me-2"></i> Filter
                </button>
            </div>
        </div>
    </form>

    <div class="row gx-4">
        @foreach (var status in statuses)
        {
            <div class="col-lg-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3 px-2">
                    <h5 class="fw-bold text-dark mb-0">@status</h5>
                    <span class="badge bg-white text-dark border rounded-pill px-3 shadow-sm">
                        @Model.Count(t => t.Status == status)
                    </span>
                </div>

                <div class="task-list p-2 rounded-3" style="min-height: 70vh; background-color: rgba(0,0,0,0.03);" data-status="@status">
                    @foreach (var task in Model.Where(t => t.Status == status))
                    {
                        <div class="card mb-3 border-0 shadow-sm border-start border-4 @GetPriorityBorder(task.Priority) draggable-task"
                             data-id="@task.TaskId" style="cursor: grab;">
                            <div class="card-body">
                                <div class="d-flex justify-content-between mb-2">
                                    <h6 class="fw-bold mb-0 text-dark">@task.Title</h6>
                                </div>
                                <p class="small text-muted mb-3 text-truncate-2">@task.Description</p>

                                <div class="d-flex align-items-center mb-3">
                                    <span class="badge @GetBadgeStyle(task.Priority) me-2 px-2 py-1">@task.Priority.ToUpper()</span>
                                    <small class="text-muted ms-auto"><strong class="text-primary">Project:</strong> @task.Project?.Title</small>
                                </div>

                                <div class="mb-2">
                                    <small class="text-muted"><strong class="text-info">Assign To:</strong> @task.Assignee?.FullName</small>
                                </div>

                                <div class="pt-2 border-top">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex gap-3 small text-muted">
                                            <span><i class="bi bi-calendar3 me-1"></i>@task.DueDate.ToString("MM/dd/yyyy")</span>
                                            <span class="text-primary fw-bold">
                                                <i class="bi bi-chat-left-text me-1"></i>@task.Comments?.Count
                                            </span>
                                        </div>
                                        <a asp-controller="TMemberTask" asp-action="Details" asp-route-id="@task.TaskId" class="btn btn-link btn-sm text-decoration-none p-0 text-primary fw-bold">View details →</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@functions {
    string GetPriorityBorder(string p) => p?.ToLower() switch
    {
        "critical" => "border-danger",
        "high" => "border-danger",
        "medium" => "border-warning",
        "low" => "border-success",
        _ => "border-secondary"
    };

    string GetBadgeStyle(string p) => p?.ToLower() switch
    {
        "critical" => "bg-danger-subtle text-danger border border-danger-subtle",
        "high" => "bg-danger-subtle text-danger border border-danger-subtle",
        "medium" => "bg-warning-subtle text-warning border border-warning-subtle",
        "low" => "bg-success-subtle text-success border border-success-subtle",
        _ => "bg-light text-dark border"
    };
}

<style>
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .draggable-task:active {
        cursor: grabbing !important;
    }

    .bg-danger-subtle {
        background-color: #f8d7da;
    }

    .bg-warning-subtle {
        background-color: #fff3cd;
    }

    .bg-success-subtle {
        background-color: #d1e7dd;
    }

    .task-list {
        transition: background-color 0.2s ease;
    }

    .sortable-ghost {
        opacity: 0.4;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.task-list').forEach(column => {
    new Sortable(column, {
    group: 'tasks',
    animation: 250,
    ghostClass: 'sortable-ghost',
    dragClass: 'shadow-lg',
    onEnd: function (evt) {
    const taskId = evt.item.getAttribute('data-id');
    const newStatus = evt.to.getAttribute('data-status');

    if (evt.from !== evt.to) {
    // Dynamically update UI column summary counters instantly
    const fromBadge = evt.from.closest('.col-lg-4').querySelector('.badge');
    fromBadge.innerText = evt.from.querySelectorAll('.draggable-task').length;

    const toBadge = evt.to.closest('.col-lg-4').querySelector('.badge');
    toBadge.innerText = evt.to.querySelectorAll('.draggable-task').length;

    // Pointing to TMemberTask instead of Task
    fetch(`/TMemberTask/UpdateStatus?id=${taskId}&status=${newStatus}`, {
    method: 'POST',
    headers: {
    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
    }
    }).then(response => {
    if (!response.ok) {
    alert("Error updating task status. Reverting change.");
    location.reload();
    }
    });
    }
    }
    });
    });
    });
</script>