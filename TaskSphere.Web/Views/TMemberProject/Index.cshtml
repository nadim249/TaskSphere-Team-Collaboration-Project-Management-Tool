@model List<TaskSphere.Entities.Project>

<div class="container-fluid py-4">
    <div class="mb-4">
        <h3 class="fw-bold text-dark">My Projects</h3>
        <p class="text-muted">A read-only overview of projects where you are assigned to tasks.</p>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var project in Model)
            {
                // Dynamic Calculation of Progress Percentage
                int totalTasks = project.Tasks != null ? project.Tasks.Count : 0;
                int completedTasks = project.Tasks != null ? project.Tasks.Count(t => t.Status?.ToLower() == "completed") : 0;
                int progress = totalTasks > 0 ? (completedTasks * 100) / totalTasks : 0;

                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 15px;">
                        <h5 class="fw-bold mb-2">@project.Title</h5>
                        <p class="text-muted small mb-3">@(project.Description ?? "No description available.")</p>

                        <div class="mb-3">
                            <span class="badge @(project.Priority == "High" ? "bg-danger" : "bg-warning") text-white">
                                @project.Priority Priority
                            </span>
                        </div>

                        <div class="small text-muted mb-2">
                            <i class="bi bi-calendar-event me-1"></i> Due: @(project.Deadline?.ToString("MM/dd/yyyy") ?? "N/A")
                        </div>

                        <div class="progress" style="height: 8px; background-color: #f1f5f9;">
                            <div class="progress-bar"
                                 style="width: @(progress)%; background-color: #6366f1 !important;">
                            </div>
                        </div>
                        <small class="text-muted mt-2 d-block">@progress% Complete</small>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-folder-x fs-1 text-muted"></i>
                <p class="mt-3 text-muted">You are not currently assigned to any projects.</p>
            </div>
        }
    </div>
</div>